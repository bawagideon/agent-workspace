# ==============================================================================
# GIDEON AI HQ V5.2 — PRODUCTION CLOUD RUNTIME ENVIRONMENT TEMPLATE
# ==============================================================================
# Instructions:
# 1. On your Oracle VM / Cloud Host, copy this file: cp .env.production.example .env
# 2. Fill in your actual production credentials (never commit .env to git).
# 3. Launch the stack: docker compose up -d
# ==============================================================================

# --- Host & Machine Identification ---
MACHINE_ID=GIDMACHINE_ORACLE_A1
WORKSPACE_ROOT=/workspace

# --- Supabase Cloud Configuration ---
# (From your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tunfhlthcmznagmtawcx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Cryptographic Security & Anti-Tamper Keys ---
# (Generate a 64-char random hex string: openssl rand -hex 32)
HMAC_PLAN_SECRET=generate_strong_64_hex_secret_here
GIDEON_HMAC_SECRET=generate_strong_64_hex_secret_here

# --- OpenClaw Gateway Security ---
# (Generate random token: openssl rand -hex 16)
OPENCLAW_AUTH_TOKEN=generate_openclaw_gateway_token_here

# --- Telegram Mobile Control Plane ---
# 1. Create a bot with @BotFather on Telegram to get your TELEGRAM_BOT_TOKEN
# 2. Send a message to @userinfobot to get your numeric Telegram user ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_ADMIN_CHAT_ID=your_numeric_telegram_chat_id
TELEGRAM_ALLOWED_USERS=your_numeric_telegram_chat_id

# --- AI Intelligence Provider ---
# (From Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
