{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@gideon/shared": ["packages/shared/src/index.ts"],
      "@gideon/policy": ["packages/policy/src/index.ts"],
      "@gideon/tools": ["packages/tools/src/index.ts"],
      "@gideon/runner": ["packages/runner/src/index.ts"],
      "@gideon/runtime": ["packages/runtime/src/index.ts"],
      "@gideon/agents": ["packages/agents/src/index.ts"],
      "@gideon/memory": ["packages/memory/src/index.ts"],
      "@/*": ["apps/hq/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
