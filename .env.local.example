# Machine & Local Runner Identity
MACHINE_ID=GIDMACHINE_WIN
RUNNER_SECRET=gideon-runner-secret-key-3.0.0
HMAC_PLAN_SECRET=gideon-hmac-plan-signing-secret

# GitHub Integration (Optional)
GITHUB_TOKEN=your-github-personal-access-token
